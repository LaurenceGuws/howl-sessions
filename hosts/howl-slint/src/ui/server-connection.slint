import { VerticalBox, HorizontalBox, GridBox } from "std-widgets.slint";
import { Style } from "style.slint";
import { ConnectionAction } from "connection-action.slint";

export struct SessionRow { server-id: string, session-id: string, instance-id: string, title: string }
export struct ServerProfile { id: string, name: string, endpoint: string, visible: bool, status: string, sessions: [SessionRow] }

component Field inherits Rectangle {
    in property <Style> style;
    in-out property <string> text;
    in property <string> label;
    accessible-role: text-input;
    accessible-label: root.label;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    min-width: 0px;
    forward-focus: input;
    border-radius: root.style.radius;
    border-width: root.style.stroke;
    border-color: input.has-focus ? root.style.palette.accent : root.style.palette.border;
    background: root.style.palette.background;
    TouchArea { clicked => { input.focus(); } }
    HorizontalBox {
        padding: root.style.padding;
        input := TextInput {
            text <=> root.text;
            single-line: true;
            min-height: 1rem;
            vertical-alignment: center;
            color: root.style.palette.text;
            selection-background-color: root.style.palette.selected;
            selection-foreground-color: root.style.palette.text;
            min-width: 0px;
            horizontal-stretch: 1;
        }
    }
}

// A server draft. Saving and validation belong to the settings owner.
export component ServerConnection inherits Rectangle {
    in property <Style> style;
    in property <string> profile-id;
    in-out property <string> draft-name;
    in-out property <string> draft-endpoint;
    in property <string> error;
    forward-focus: name-field;
    init => { name-field.focus(); }
    callback save(string, string, string);
    callback remove(string);
    callback refresh(string);
    callback close();
    vertical-stretch: 0;
    background: root.style.palette.chrome;
    border-radius: root.style.radius;
    border-width: root.style.stroke;
    border-color: root.style.palette.border;
    VerticalBox {
        padding: root.style.padding;
        spacing: root.style.padding;
        GridBox {
            padding: 0px;
            vertical-stretch: 0;
            spacing: root.style.spacing;
            Row {
                Text { text: "Name"; color: root.style.palette.secondary; vertical-alignment: center; }
                name-field := Field { style: root.style; label: "Server name"; text <=> root.draft-name; }
            }
            Row {
                Text { text: "Address"; color: root.style.palette.secondary; vertical-alignment: center; }
                Field { style: root.style; label: "Server address"; text <=> root.draft-endpoint; }
            }
        }
        if root.error != "": Text { text: root.error; color: root.style.palette.text; wrap: word-wrap; }
        HorizontalBox {
            padding: 0px;
            vertical-stretch: 0;
            spacing: root.style.spacing;
            ConnectionAction { style: root.style; text: "Save"; enabled: root.draft-name != "" && root.draft-endpoint != ""; clicked => { root.save(root.profile-id, root.draft-name, root.draft-endpoint); } }
            ConnectionAction { style: root.style; text: "Cancel"; clicked => { root.close(); } }

        }
        if root.profile-id != "": HorizontalBox {
            padding: 0px;
            vertical-stretch: 0;
            spacing: root.style.spacing;
            ConnectionAction { style: root.style; text: "Refresh"; clicked => { root.refresh(root.profile-id); } }
            ConnectionAction { style: root.style; text: "Remove"; clicked => { root.remove(root.profile-id); } }
        }
    }
}

import { IconSet } from "@lucide";
import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Style } from "style.slint";
import { IconButton } from "icon-button.slint";

export component TabBar inherits Rectangle {
    in property <Style> style;
    in property <string> selected-title;
    in property <bool> show-sessions;
    callback toggle-sessions();
    in property <bool> terminal-enabled;
    callback detach-terminal();

    vertical-stretch: 0;
    background: root.style.palette.terminal;
    VerticalBox {
        padding: 0px;
        spacing: 0px;
        Rectangle {
            vertical-stretch: 0;
            background: root.style.palette.chrome;
            HorizontalBox {
                padding: root.style.spacing;
                spacing: root.style.spacing;
                if !root.show-sessions: IconButton {
                    style: root.style;
                    icon: IconSet.ChevronsRight;
                    label: "Show sessions";
                    clicked => { root.toggle-sessions(); }
                }
                active-tab := Rectangle {
                    horizontal-stretch: 0;
                    border-radius: root.style.radius;
                    // Current-session marker, not an extra action button.
                    border-width: root.style.stroke;
                    border-color: root.style.palette.selection-border;
                    background: tab-hover.has-hover ? root.style.palette.selected-hover : root.style.palette.selected;
                    HorizontalBox {
                        padding: root.style.padding;
                        spacing: root.style.padding;
                        Text { text: ">_"; font-family: "monospace"; color: root.style.palette.accent; }
                        Text {
                            text: root.selected-title;
                            color: root.style.palette.text;
                        }
                    }
                    // Hover acknowledges the current tab; no fake click action or keyboard stop.
                    tab-hover := TouchArea { }
                }
                if root.terminal-enabled: IconButton {
                    style: root.style;
                    icon: IconSet.X;
                    label: "Detach terminal";
                    clicked => { root.detach-terminal(); }
                }
                Rectangle { horizontal-stretch: 1; }

            }
        }
    }
}

import { IconSet } from "@lucide";
import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { IconButton } from "icon-button.slint";
import { ServerProfile } from "server-connection.slint";
import { Style } from "style.slint";

export component SessionList inherits Rectangle {
    in property <Style> style;
    in property <[ServerProfile]> servers;
    in property <string> settings-error;
    in property <string> selected-profile-id;
    in property <string> selected-server-id;
    in property <string> selected-session-id;
    in property <string> selected-instance-id;
    in property <string> detail;
    out property <length> content-minimum: header.min-width;
    in-out property <length> retained-width: 0px;
    callback toggle-sessions();
    callback edit-server(string, string, string);
    callback toggle-server(string);
    callback refresh-server(string);
    callback select-instance(string, string, string, string);
    horizontal-stretch: 0;
    preferred-width: root.retained-width > 0px ? max(root.content-minimum, root.retained-width) : max(root.content-minimum, 18rem);
    background: root.style.palette.sidebar;
    VerticalBox {
        padding: 0px;
        spacing: 0px;
        header := HorizontalBox {
            vertical-stretch: 0;
            padding: root.style.spacing;
            spacing: root.style.spacing;
            HorizontalBox {
                padding: root.style.padding;
                Text { text: "Howl"; font-weight: root.style.emphasis; color: root.style.palette.text; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
            }
            IconButton { style: root.style; icon: IconSet.ChevronsLeft; label: "Hide sessions"; clicked => { root.toggle-sessions(); } }
        }
        ScrollView {
            horizontal-stretch: 1;
            VerticalBox {
                padding: root.style.padding;
                spacing: root.style.padding;
                HorizontalBox {
                    padding: 0px;
                    vertical-stretch: 0;
                    Text { text: "Servers"; font-size: 0.85rem; color: root.style.palette.muted; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { style: root.style; icon: IconSet.Plus; label: "Add server"; clicked => { root.edit-server("", "", ""); } }
                }
                if root.servers.length == 0: Text { text: "Add a server to find its sessions."; wrap: word-wrap; color: root.style.palette.muted; }
                for server in root.servers: VerticalBox {
                    vertical-stretch: 0;
                    padding: 0px;
                    spacing: root.style.spacing;
                    HorizontalBox {
                        padding: 0px;
                        vertical-stretch: 0;
                        spacing: root.style.spacing;
                        IconButton { style: root.style; icon: server.visible ? IconSet.Eye : IconSet.EyeOff; label: server.visible ? "Hide server sessions" : "Show server sessions"; clicked => { root.toggle-server(server.id); } }
                        Text { text: server.name; color: server.visible ? root.style.palette.text : root.style.palette.muted; font-weight: root.style.emphasis; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        IconButton { style: root.style; icon: IconSet.Ellipsis; label: "Edit server"; clicked => { root.edit-server(server.id, server.name, server.endpoint); } }
                    }
                    if server.visible: VerticalBox {
                        vertical-stretch: 0;
                        padding-left: root.style.padding;
                        padding-right: 0px;
                        padding-top: 0px;
                        padding-bottom: 0px;
                        spacing: root.style.spacing;
                        if server.status != "" && server.sessions.length == 0: Text { text: server.status; wrap: word-wrap; font-size: 0.85rem; color: root.style.palette.muted; }
                        for session in server.sessions: Rectangle {
                            private property <bool> selected: root.selected-profile-id == server.id && root.selected-server-id == session.server-id && root.selected-session-id == session.session-id && root.selected-instance-id == session.instance-id;
                            vertical-stretch: 0;
                            accessible-role: button;
                            accessible-label: session.title;
                            forward-focus: row-focus;
                            border-radius: root.style.radius;
                            border-width: root.style.stroke;
                            border-color: row-focus.has-focus ? root.style.palette.accent : self.selected ? root.style.palette.selection-border : row-input.has-hover ? root.style.palette.border : transparent;
                            background: row-input.pressed ? root.style.palette.pressed : self.selected ? (row-input.has-hover ? root.style.palette.selected-hover : root.style.palette.selected) : row-input.has-hover ? root.style.palette.hover : transparent;
                            HorizontalBox {
                                padding: root.style.padding;
                                spacing: root.style.padding;
                                Text { text: ">_"; font-family: "monospace"; color: root.style.palette.accent; }
                                Text { text: session.title; color: root.style.palette.text; horizontal-stretch: 1; overflow: elide; }
                            }
                            row-focus := FocusScope {
                                key-pressed(event) => {
                                    if event.text == Key.Space || event.text == Key.Return { root.select-instance(server.id, session.server-id, session.session-id, session.instance-id); return accept; }
                                    return reject;
                                }
                            }
                            row-input := TouchArea { clicked => { row-focus.focus(); root.select-instance(server.id, session.server-id, session.session-id, session.instance-id); } }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}

import { Icon, IconDisplay } from "@lucide";
import { HorizontalBox } from "std-widgets.slint";
import { Style } from "style.slint";

export component ToolButton inherits Rectangle {
    in property <Style> style;
    in property <string> text;
    in property <Icon> icon;
    in property <string> label: root.text;
    callback clicked();
    horizontal-stretch: 0;
    vertical-stretch: 1;
    accessible-role: button;
    accessible-label: root.label;
    forward-focus: focus;
    background: touch.has-hover || focus.has-focus ? root.style.palette.hover : transparent;
    border-width: focus.has-focus ? root.style.stroke : 0px;
    border-color: root.style.palette.accent;
    HorizontalBox {
        padding: root.style.padding;
        if root.icon.paths.length > 0: Rectangle {
            width: 1rem;
            min-height: 1rem;
            IconDisplay {
                y: (parent.height - self.height) / 2;
                icon: root.icon;
                size: 1rem;
                stroke: root.style.palette.secondary;
            }
        }
        if root.text != "": Text { text: root.text; color: root.style.palette.secondary; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea { clicked => { focus.focus(); root.clicked(); } }
}

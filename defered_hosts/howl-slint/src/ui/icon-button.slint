import { Icon, IconDisplay } from "@lucide";
import { HorizontalBox } from "std-widgets.slint";
import { Style } from "style.slint";

export component IconButton inherits Rectangle {
    in property <Style> style;
    in property <Icon> icon;
    in property <string> label;
    callback clicked();
    horizontal-stretch: 0;
    vertical-stretch: 1;
    accessible-role: button;
    accessible-label: root.label;
    forward-focus: focus;
    background: touch.pressed ? root.style.palette.pressed : touch.has-hover ? root.style.palette.hover : transparent;
    border-radius: root.style.radius;
    border-width: root.style.stroke;
    border-color: focus.has-focus ? root.style.palette.accent : touch.has-hover ? root.style.palette.border : transparent;
    HorizontalBox {
        padding: root.style.padding;
        if root.icon.paths.length > 0: Rectangle {
            width: 1rem;
            min-height: 1rem;
            IconDisplay {
                y: (parent.height - self.height) / 2;
                icon: root.icon;
                size: 1rem;
                stroke: touch.has-hover || focus.has-focus ? root.style.palette.text : root.style.palette.secondary;
            }
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea { clicked => { focus.focus(); root.clicked(); } }
}

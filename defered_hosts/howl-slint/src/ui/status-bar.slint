import { HorizontalBox } from "std-widgets.slint";
import { Style } from "style.slint";

export component StatusBar inherits Rectangle {
    in property <Style> style;
    in property <string> status: "○  Offline";
    in property <string> detail: "Disconnected";

    vertical-stretch: 0;
    background: root.style.palette.chrome;
    HorizontalBox {
        padding-left: root.style.padding;
        padding-right: root.style.padding;
        padding-top: root.style.spacing;
        padding-bottom: root.style.spacing;
        spacing: root.style.padding;
        Text {
            text: root.status;
            min-width: 0px;
            overflow: elide;
            color: root.style.palette.secondary;
            horizontal-stretch: 1;
        }
        Text {
            text: root.detail;
            min-width: 0px;
            overflow: elide;
            horizontal-stretch: 1;
            horizontal-alignment: right;
            color: root.style.palette.muted;
        }
    }
}

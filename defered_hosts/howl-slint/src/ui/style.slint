export struct Palette {
    background: color,
    chrome: color,
    sidebar: color,
    terminal: color,
    hover: color,
    selected: color,
    selected-hover: color,
    pressed: color,
    selection-border: color,
    border: color,
    text: color,
    secondary: color,
    muted: color,
    accent: color,
}

export struct Style {
    palette: Palette,
    font-family: string,
    font-size: length,
    terminal-regular: string,
    terminal-italic: string,
    terminal-bold: string,
    terminal-bold-italic: string,
    terminal-fallbacks: [string],
    terminal-font-size: length,
    padding: length,
    spacing: length,
    stroke: length,
    radius: length,
    emphasis: int,
}

export global Theme {
    out property <Style> defaults: {
        palette: {
            background: #131619,
            chrome: #1b1f23,
            sidebar: #181c20,
            terminal: #111416,
            hover: #23292e,
            selected: #25332e,
            selected-hover: #2d3d35,
            pressed: #30383e,
            selection-border: #394b42,
            border: #2a3035,
            text: #dbe2e6,
            secondary: #a4adb5,
            muted: #78848e,
            accent: #8eb6a0,
        },
        // Empty family / zero size retain Slint platform font defaults.
        font-family: "",
        font-size: 0px,
        // Exact file paths or Fontconfig patterns. Matches saved howl-app faces.
        terminal-regular: "Iosevka Nerd Font:style=Regular",
        terminal-italic: "Iosevka Nerd Font:style=Italic",
        terminal-bold: "Iosevka Nerd Font:style=Bold",
        terminal-bold-italic: "Iosevka Nerd Font:style=Bold Italic",
        terminal-fallbacks: ["Noto Sans Arabic", "Noto Sans CJK JP", "Noto Color Emoji"],
        terminal-font-size: 18px,
        padding: 6px,
        spacing: 2px,
        stroke: 1px,
        radius: 4px,
        emphasis: 600,
    };
}

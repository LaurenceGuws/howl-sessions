import { ServerConnection, ServerProfile } from "server-connection.slint";
import { TerminalView } from "terminal-view.slint";
import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { Style, Theme } from "style.slint";
import { SessionList } from "session-list.slint";
import { TabBar } from "tab-bar.slint";
import { StatusBar } from "status-bar.slint";

export component App inherits Window {
    in property <Style> style: Theme.defaults;
    title: "Howl Sessions";
    default-font-family: root.style.font-family;
    default-font-size: root.style.font-size;
    preferred-width: 72rem;
    preferred-height: 48rem;
    background: root.style.palette.background;

    private property <bool> editing-server: false;
    private property <string> editing-id;
    private property <string> draft-name;
    private property <string> draft-endpoint;
    in property <[ServerProfile]> servers;
    in property <string> settings-error;
    in property <string> selected-profile-id;
    in property <string> selected-server-id;
    in property <string> selected-session-id;
    in property <string> selected-instance-id;
    callback save-server(string, string, string);
    callback save-font-size(float);
    callback remove-server(string);
    callback toggle-server(string);
    callback refresh-server(string);
    callback select-instance(string, string, string, string);
    in-out property <length> terminal-font-size: root.style.terminal-font-size;
    in property <string> selected-title;
    in-out property <bool> show-sessions: !root.compact;
    // Portrait windows show one pane; landscape windows share the space.
    private property <bool> compact: shell-layout.width < shell-layout.height;
    private property <length> sidebar-width: 0px;
    in property <string> font-note;
    in property <bool> server-connected: false;
    in property <bool> server-connecting: false;
    in property <string> connection-detail: "No connection";
    callback disconnect-server();
    in property <bool> terminal-enabled: false;
    in property <image> terminal-frame;
    in property <string> terminal-status: "Disconnected";
    callback terminal-key(KeyEvent, bool);
    callback terminal-resize(int, int, int);

    // Fill the window without feeding responsive content back into its size.
    shell-layout := VerticalBox {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        padding: 0px;
        spacing: 0px;

        panes := HorizontalBox {
            padding: 0px;
            spacing: root.show-sessions ? root.style.stroke : 0px;
            // The sidebar owns its header; tabs belong to the terminal pane.
            sidebar := SessionList {
                visible: root.show-sessions;
                min-width: root.show-sessions ? self.content-minimum : 0px;
                horizontal-stretch: root.compact ? 1 : 0;
                max-width: !root.show-sessions ? 0px : root.compact ? shell-layout.width : shell-layout.width / 2;
                retained-width <=> root.sidebar-width;
                style: root.style;
                servers: root.servers;
                settings-error: root.settings-error;
                selected-profile-id: root.selected-profile-id;
                selected-server-id: root.selected-server-id;
                selected-session-id: root.selected-session-id;
                selected-instance-id: root.selected-instance-id;
                edit-server(id, name, endpoint) => {
                    root.editing-id = id;
                    root.draft-name = name;
                    root.draft-endpoint = endpoint;
                    root.editing-server = true;
                }
                toggle-server(id) => { root.toggle-server(id); }
                refresh-server(id) => { root.refresh-server(id); }
                detail: root.connection-detail;
                toggle-sessions => { root.show-sessions = !root.show-sessions; }
                select-instance(profile, server, session, instance) => {
                    root.select-instance(profile, server, session, instance);
                    if root.compact { root.show-sessions = false; }
                }
            }

            if !root.compact || !root.show-sessions: VerticalBox {
                horizontal-stretch: 1;
                padding: 0px;
                spacing: 0px;
                TabBar {
                    style: root.style;
                    selected-title: root.selected-title;
                    terminal-enabled: root.terminal-enabled;
                    detach-terminal => { root.disconnect-server(); }
                    show-sessions: root.show-sessions;
                    toggle-sessions => { root.show-sessions = !root.show-sessions; }
                }
                if root.terminal-enabled: TerminalView {
                    style: root.style;
                    frame: root.terminal-frame;
                    font-size <=> root.terminal-font-size;
                    font-size-committed(size) => { root.save-font-size(size); }
                    key(event, released) => { root.terminal-key(event, released); }
                    resized(w, h, pixels) => { root.terminal-resize(w, h, pixels); }
                }
                if !root.terminal-enabled: Rectangle {
                    vertical-stretch: 1;
                    background: root.style.palette.terminal;
                }
            }
        }
        status-bar := StatusBar {
            style: root.style;
            status: root.settings-error != "" ? root.settings-error : root.terminal-status;
            detail: root.font-note != "" ? root.font-note : root.connection-detail;
        }
    }

    // Keep the gesture owner alive while its sidebar is temporarily collapsed.
    resize := TouchArea {
        private property <bool> dragging: false;
        private property <length> drag-x;
        private property <length> drag-width;
        enabled: !root.compact && (root.show-sessions || self.dragging);
        x: self.dragging ? self.drag-x : shell-layout.x + sidebar.width + root.style.stroke / 2 - self.width / 2;
        y: shell-layout.y + panes.y;
        width: 2 * root.style.padding + root.style.stroke;
        height: panes.height;
        mouse-cursor: col-resize;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.drag-x = self.x;
                self.drag-width = sidebar.width;
                self.dragging = true;

            }
        }
        changed pressed => { if !self.pressed { self.dragging = false; } }
        moved => {
            if self.pressed {
                let requested = self.drag-width + self.mouse-x - self.pressed-x;
                root.show-sessions = requested >= sidebar.content-minimum;
                if root.show-sessions { root.sidebar-width = min(shell-layout.width / 2, requested); }
            }
        }
    }
    if root.show-sessions && !root.compact: Rectangle {
        x: shell-layout.x + sidebar.width;
        y: shell-layout.y + panes.y;
        width: root.style.stroke;
        height: panes.height;
        background: resize.has-hover || resize.pressed ? root.style.palette.accent : transparent;
    }

    // Keep draft ownership independent of catalog refreshes and sidebar visibility.
    if root.editing-server: Rectangle {
        background: #0008;
        TouchArea { } // Modal input shield; dismissal is explicit.
        available := Rectangle {
            x: root.safe-area-insets.left;
            y: root.safe-area-insets.top;
            width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
            // Android reports the visible IME rectangle in window coordinates.
            height: max(0px, min(root.height - root.safe-area-insets.bottom,
                root.virtual-keyboard-size.height > 0px ? root.virtual-keyboard-position.y : root.height) - self.y);
            dialog := ScrollView {
                x: (parent.width - self.width) / 2;
                y: max(0px, (parent.height - self.height) / 2);
                width: min(32rem, max(0px, parent.width - 2 * root.style.padding));
                height: min(editor.preferred-height, max(0px, parent.height - 2 * root.style.padding));
                editor := ServerConnection {
                    style: root.style;
                    profile-id: root.editing-id;
                    draft-name <=> root.draft-name;
                    draft-endpoint <=> root.draft-endpoint;
                    error: root.settings-error;
                    save(id, name, endpoint) => {
                        root.save-server(id, name, endpoint);
                        if root.settings-error == "" { root.editing-server = false; }
                    }
                    remove(id) => {
                        root.remove-server(id);
                        if root.settings-error == "" { root.editing-server = false; }
                    }
                    refresh(id) => { root.refresh-server(id); }
                    close => { root.editing-server = false; }
                }
            }
        }
    }

}
